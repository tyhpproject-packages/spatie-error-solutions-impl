{
    "name": "tyhpdef/spatie-error-solutions-impl",
    "description": "Implementation package for tyhpdef/spatie-error-solutions. Require tyhpdef/spatie-error-solutions, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.0.5.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/spatie-backtrace": "@dev",
                "tyhpdef/spatie-laravel-flare": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/spatie-error-solutions"
        }
    },
    "require": {
        "php": ">=8.2",
        "spatie/error-solutions": "2.0.5"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/spatie-backtrace": "@dev",
        "tyhpdef/spatie-laravel-flare": "@dev"
    }
}
